# Development environment variables
# Used by Vite during `npm run dev`
VITE_API_BASE=http://localhost:5000/api

# Google Maps API key — https://console.cloud.google.com
# Enable: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDQZjDtu5X8zq1RTast3VfyVA-3NWOq1zo

# Firebase Web Cloud Messaging (FCM Web Push)
# Get from: Firebase Console → Project settings → General → Your apps (Web)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=jinkzo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jinkzo
VITE_FIREBASE_STORAGE_BUCKET=jinkzo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=71878062534
VITE_FIREBASE_APP_ID=1:71878062534:web:xxxxxxxxxxxx
# Get from: Firebase Console → Project settings → Cloud Messaging → Web configuration → Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_firebase_web_push_vapid_public_key
